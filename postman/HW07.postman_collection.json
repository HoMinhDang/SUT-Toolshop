	"item": [
		{
			"name": "Search Product",
			"item": [
				{
					"name": "products/search",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is as expected\", function () {",
									"    pm.response.to.have.status(parseInt(pm.iterationData.get(\"Expected_Status\")));",
									"});",
									"",
									"let responseData = {};",
									"try {",
									"    responseData = pm.response.json();",
									"} catch (e) {",
									"    pm.expect.fail(\"Response is not JSON\");",
									"}",
									"",
									"let condition = pm.iterationData.get(\"Expected_Condition\");",
									"",
									"if (condition === \"ContainsResult\") {",
									"    pm.test(\"Should contain at least 1 result\", function () {",
									"        pm.expect(responseData.data && responseData.data.length).to.be.above(0);",
									"    });",
									"} else if (condition === \"NoResult\") {",
									"    pm.test(\"Should return empty result\", function () {",
									"        pm.expect(responseData.data && responseData.data.length).to.eql(0);",
									"    });",
									"}",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseURL}}/products/search?q={{Query}}",
							"host": [
								"{{baseURL}}"
							],
							"path": [
								"products",
								"search"
							],
							"query": [
								{
									"key": "q",
									"value": "{{Query}}"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Sort Product",
			"item": [
				{
					"name": "products/sort",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Parse JSON response",
									"let data;",
									"try {",
									"    data = pm.response.json();",
									"} catch (e) {",
									"    data = [];",
									"}",
									"",
									"// Test 1: Status code hợp lệ",
									"pm.test(\"Status code OK\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 400, 422, 500]);",
									"});",
									"",
									"// Hàm kiểm tra sắp xếp",
									"function isSorted(arr, key, order = 'asc') {",
									"    for (let i = 1; i < arr.length; i++) {",
									"        if (order === 'asc' && arr[i - 1][key] > arr[i][key]) return false;",
									"        if (order === 'desc' && arr[i - 1][key] < arr[i][key]) return false;",
									"    }",
									"    return true;",
									"}",
									"",
									"// Lấy giá trị sort từ file CSV/JSON",
									"let sortValue = pm.iterationData.get(\"sort\");",
									"",
									"// Test 2: Kiểm tra thứ tự nếu là case hợp lệ",
									"switch (sortValue) {",
									"    case \"name,asc\":",
									"        pm.test(\"Sort theo name ASC đúng\", function () {",
									"            pm.expect(isSorted(data, 'name', 'asc')).to.be.true;",
									"        });",
									"        break;",
									"",
									"    case \"name,desc\":",
									"        pm.test(\"Sort theo name DESC đúng\", function () {",
									"            pm.expect(isSorted(data, 'name', 'desc')).to.be.true;",
									"        });",
									"        break;",
									"",
									"    case \"price,asc\":",
									"        pm.test(\"Sort theo price ASC đúng\", function () {",
									"            pm.expect(isSorted(data, 'price', 'asc')).to.be.true;",
									"        });",
									"        break;",
									"",
									"    case \"price,desc\":",
									"        pm.test(\"Sort theo price DESC đúng\", function () {",
									"            pm.expect(isSorted(data, 'price', 'desc')).to.be.true;",
									"        });",
									"        break;",
									"",
									"    default:",
									"        pm.test(`Sort param '${sortValue}' không hợp lệ`, function () {",
									"            pm.expect(pm.response.code).to.be.oneOf([400, 422, 500]);",
									"        });",
									"}",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseURL}}/products?sort={{sort}}",
							"host": [
								"{{baseURL}}"
							],
							"path": [
								"products"
							],
							"query": [
								{
									"key": "sort",
									"value": "{{sort}}"
								}
							]
						}
					},
					"response": []
				}
			]
		},
